<IfModule mod_rewrite.c>
  RewriteEngine On

  # Disable automatic trailing-slash redirects on physical directories.
  <IfModule mod_dir.c>
    DirectorySlash Off
  </IfModule>

  # Force HTTPS first.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: redirect www to apex domain.
  RewriteCond %{HTTP_HOST} ^www\.badminton-saint-martin\.com$ [NC]
  RewriteRule ^ https://badminton-saint-martin.com%{REQUEST_URI} [L,R=301]

  # Serve slashless prerendered pages directly from their index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+[^/])$ $1/index.html [L]

  RewriteBase /

  # Serve existing files and directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Return an explicit static 404 page for unknown URLs.
ErrorDocument 404 /404.html
